# AOS configuration — copy to .env and fill in.
# .env is gitignored. Never commit real values.

# ── Paths ────────────────────────────────────────────────────
# Hermes install root, the folder holding kanban/boards and profiles.
# Leave blank for the default: $LOCALAPPDATA/hermes on Windows, ~/.hermes
# elsewhere. Not HERMES_HOME, which Hermes points at a single profile.
# Linux deploy:      /home/aos/.hermes
AOS_HERMES_ROOT=

# Where agent deliverables are stored. Must NOT be inside the repo.
ARTIFACT_DIR=

# ── App ──────────────────────────────────────────────────────
AOS_ENV=development
AOS_HOST=127.0.0.1
AOS_PORT=8000

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Session lifetime (hours). Short by design — pod owners sign
# Amber outputs, so a stale session is a signing-authority risk.
SESSION_TTL_HOURS=12

# ── Auth ─────────────────────────────────────────────────────
# Identity channel for login codes: telegram | email
# NOTE: the signing-identity decision is still open. A consumer
# messaging account is a weak anchor for a clinical signature.
AUTH_CHANNEL=telegram

# Telegram bot used ONLY for delivering login codes.
# Separate from the six pod bots.
AUTH_TELEGRAM_BOT_TOKEN=

# SMTP, if AUTH_CHANNEL=email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# One-time code settings
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_HOUR=10
RATE_LIMIT_API_PER_MINUTE=120
